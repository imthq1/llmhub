# Copy to .env and fill in real values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/llmhub
DB_USERNAME=neondb_owner
DB_PASSWORD=

# Required by the existing application.properties
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI used by the frontend OAuth request.
GOOGLE_REDIRECT_URI=http://localhost:5173/login/google
JWT_BASE64_SECRET=
